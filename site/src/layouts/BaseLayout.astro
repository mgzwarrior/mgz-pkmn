---
import "../styles/global.css";
import AnnouncementBanner from "../components/AnnouncementBanner.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "mgz-pkmn — the smart prep tool for Pokemon card shows",
  description = "Build wishlists, pull market prices across three open data sources, and walk into your next card show informed. Open-source CLI and web app.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL("/social-preview-tropical.png", Astro.site).toString();
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Resolve the theme before first paint to avoid a flash. A saved choice
      // wins; otherwise follow the OS preference, defaulting to dark.
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme = stored
            ? stored
            : window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
          document.documentElement.classList.toggle("dark", theme !== "light");
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon-tropical.svg" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-sand-50 text-coconut-700 dark:bg-husk-400 dark:text-sand-50">
    <AnnouncementBanner />
    <slot />
    <!-- Buy Me a Coffee floating widget — button only. `data-message` is
         deliberately omitted: BMC re-pops its greeting on every page load, and
         this is a multi-page site, so the message used to follow you around.
         The one-time greeting below shows it just once per session instead.
         Color matches palm-300 to align with the README button. -->
    <script
      is:inline
      data-name="BMC-Widget"
      data-cfasync="false"
      src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js"
      data-id="mgz.pkmn"
      data-description="Support me on Buy me a coffee!"
      data-color="#6BAC55"
      data-position="Right"
      data-x_margin="18"
      data-y_margin="18"
    ></script>

    <!-- One-time greeting: shows once per browsing session, not on every page. -->
    <script is:inline>
      (function () {
        var KEY = "bmc-greeted";
        try {
          if (sessionStorage.getItem(KEY) === "1") return;
          sessionStorage.setItem(KEY, "1");
        } catch (e) {}

        function mount() {
          if (document.getElementById("bmc-greeting")) return;
          var wrap = document.createElement("div");
          wrap.id = "bmc-greeting";
          wrap.setAttribute("role", "status");
          wrap.className =
            "fixed right-[18px] bottom-24 z-[999998] max-w-[min(280px,82vw)] rounded-xl border border-sand-300 bg-sand-50 p-4 pr-9 shadow-xl shadow-coconut-700/15 dark:border-husk-50 dark:bg-husk-300";

          var msg = document.createElement("button");
          msg.type = "button";
          msg.className =
            "block w-full text-left text-sm leading-relaxed text-coconut-700 dark:text-sand-50";
          msg.textContent =
            "Thanks for stopping by 🌴 Want to buy me some pizza to keep the project rolling forward?";
          msg.addEventListener("click", function () {
            var btn = document.getElementById("bmc-wbtn");
            if (btn) btn.click();
            wrap.remove();
          });

          var close = document.createElement("button");
          close.type = "button";
          close.setAttribute("aria-label", "Dismiss");
          close.className =
            "absolute right-2 top-2 inline-flex h-6 w-6 items-center justify-center rounded-md text-lg leading-none text-coconut-400 hover:bg-sand-200 dark:text-sand-300 dark:hover:bg-husk-200";
          close.innerHTML = "&times;";
          close.addEventListener("click", function () {
            wrap.remove();
          });

          wrap.appendChild(msg);
          wrap.appendChild(close);
          document.body.appendChild(wrap);
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", mount);
        } else {
          mount();
        }
      })();
    </script>
  </body>
</html>
