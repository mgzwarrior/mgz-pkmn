---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const repoUrl = "https://github.com/mgzwarrior/mgz-pkmn";
const demoUrl = "https://mgz-pkmn.onrender.com";
const discussionsUrl = `${repoUrl}/discussions`;
const newIssueUrl = `${repoUrl}/issues/new/choose`;
const cliReferenceUrl = `${repoUrl}/blob/main/docs/cli.md`;

// Card-class for the two "ways in" panels and the numbered steps. Kept in one
// place so the docs page stays visually consistent with the rest of the site.
const panelClass =
  "rounded-xl border border-sand-300 bg-sand-100 p-6 dark:border-husk-50 dark:bg-husk-200/40";

const ways = [
  {
    badge: "Easiest",
    title: "Open the web app",
    body: "Nothing to install. Swipe through cards one at a time, walk a whole set, or paste a want-list into Search — same pricing pipeline as the CLI, in the browser.",
    cta: "Open the live demo",
    href: demoUrl,
    external: true,
  },
  {
    badge: "For the terminal",
    title: "Run the CLI",
    body: "Prefer the command line? Point pkmn at a text file of cards you want and it writes the spreadsheet, binder, and checklist next to it.",
    cta: "Read the CLI reference",
    href: cliReferenceUrl,
    external: true,
  },
];

const steps = [
  {
    n: "01",
    title: "Paste your want-list",
    body: "Plain text, one card per line. Name a single card, or use a shortcut to pull a whole group. Set filters and budgets live on the same line.",
    example: "top:5 Charizard | base set",
    exampleNote: "The five priciest Charizards from Base Set.",
  },
  {
    n: "02",
    title: "Run the lookup",
    body: "Hit Look up and the pricing runs card by card against three open data sources. A determinate bar tracks it the whole way — no spinner that lies about being almost done.",
    example: "Pricing 3 of 12…",
    exampleNote: "You always know how far along it is.",
  },
  {
    n: "03",
    title: "Read the comps",
    body: "Each card lands with its market price plus four negotiation comps — 80%, 85%, 90%, and 95% of market. That's your floor and your ceiling before you ever open your mouth at the table.",
    example: "Market $240 · 80% $192 · 85% $204 · 90% $216 · 95% $228",
    exampleNote: "Walk in knowing what's fair and what's a steal.",
  },
  {
    n: "04",
    title: "Export what you'll carry",
    body: "Take it out in whatever shape fits the day — a spreadsheet for live reference, a printable binder page to hand a vendor, a checklist to tick off as you find cards, or raw JSON to pipe somewhere else.",
    example: ".xlsx · 3×3 binder PDF · checklist · JSON",
    exampleNote: "Four formats, one lookup.",
  },
];

const helpLinks = [
  {
    title: "Ask in Discussions",
    body: "Stuck, or just want to talk shop? Discussions is the place.",
    href: discussionsUrl,
  },
  {
    title: "Open an issue",
    body: "Hit a bug or a wrong price? File it with an example and it gets looked at.",
    href: newIssueUrl,
  },
  {
    title: "CLI reference",
    body: "Every flag, every output option, in one page.",
    href: cliReferenceUrl,
  },
];
---

<BaseLayout
  title="Getting started with mgz-pkmn — paste a want-list, get prices and a binder"
  description="How to use mgz-pkmn: paste a want-list, run the lookup, read market and negotiation comps, and export a spreadsheet, printable binder, checklist, or JSON. Web app or CLI."
>
  <Header />
  <main>
    <!-- Intro -->
    <section
      class="relative overflow-hidden border-b border-sand-300 dark:border-husk-200/80 px-6 py-20 sm:py-24"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_70%)]"
      >
        <div
          class="absolute inset-x-0 top-0 mx-auto h-[30rem] w-[30rem] -translate-y-1/3 rounded-full bg-sun-200/35 dark:bg-sun-400/15 blur-3xl"
        >
        </div>
      </div>

      <div class="mx-auto max-w-3xl text-center">
        <p
          class="inline-flex items-center gap-2 rounded-full border border-sand-300 bg-sand-100 px-3 py-1 text-xs font-medium text-coconut-500 dark:border-husk-50 dark:bg-husk-200/60 dark:text-sand-200"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-palm-400 dark:bg-sun-300"></span>
          Getting started
        </p>

        <h1
          class="mt-6 text-4xl sm:text-5xl font-bold tracking-tight text-coconut-700 dark:text-sand-50 text-balance"
        >
          From a list of cards to a plan you can carry.
        </h1>

        <p
          class="mt-6 text-lg text-coconut-500 dark:text-sand-200 text-balance max-w-2xl mx-auto"
        >
          mgz-pkmn takes the cards you want, prices them against three open data
          sources, and hands back a spreadsheet, a printable binder, and your
          negotiation floor. Here's the whole loop, start to finish.
        </p>
      </div>
    </section>

    <!-- Two ways in -->
    <section class="border-b border-sand-300 dark:border-husk-200/80 px-6 py-20 sm:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-2xl">
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-coconut-700 dark:text-sand-50">
            Two ways in.
          </h2>
          <p class="mt-4 text-lg text-coconut-400 dark:text-sand-300">
            Same engine either way. Pick the one that fits how you like to work.
          </p>
        </div>

        <ul class="mt-12 grid gap-6 md:grid-cols-2">
          {
            ways.map((w) => (
              <li class={`flex h-full flex-col ${panelClass}`}>
                <span class="inline-flex w-fit items-center gap-2 rounded-full border border-sun-200 bg-sun-50 px-3 py-1 text-xs font-medium text-coconut-500 dark:border-sun-400/30 dark:bg-husk-200/60 dark:text-sand-200">
                  <span class="h-1.5 w-1.5 rounded-full bg-sun-300" />
                  {w.badge}
                </span>
                <h3 class="mt-4 text-xl font-semibold text-coconut-700 dark:text-sand-50">
                  {w.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-coconut-500 dark:text-sand-300 flex-1">
                  {w.body}
                </p>
                <a
                  href={w.href}
                  target={w.external ? "_blank" : undefined}
                  rel={w.external ? "noopener noreferrer" : undefined}
                  class="mt-6 inline-flex w-fit items-center gap-1 text-sm font-semibold text-palm-500 hover:text-palm-400 dark:text-sun-300 dark:hover:text-sun-200"
                >
                  {w.cta} →
                </a>
              </li>
            ))
          }
        </ul>

        <p class="mt-6 text-sm text-sand-500 dark:text-sand-400">
          On the CLI it's one command:
          <code class="rounded-md border border-sand-300 bg-sand-50 px-1.5 py-0.5 font-mono text-xs text-coconut-700 dark:border-husk-50 dark:bg-husk-400 dark:text-sand-100">
            ./pkmn lookup wants.txt
          </code>
        </p>
      </div>
    </section>

    <!-- Four steps -->
    <section class="border-b border-sand-300 dark:border-husk-200/80 px-6 py-20 sm:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-2xl">
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-coconut-700 dark:text-sand-50">
            The loop, in four steps.
          </h2>
          <p class="mt-4 text-lg text-coconut-400 dark:text-sand-300">
            Paste, look up, read the comps, export. Same four whether you're in the
            browser or the terminal.
          </p>
        </div>

        <ol class="mt-12 grid gap-8 md:grid-cols-2">
          {
            steps.map((step) => (
              <li class={`relative ${panelClass}`}>
                <span class="absolute -top-3 -left-3 inline-flex h-10 w-10 items-center justify-center rounded-md bg-sun-300 text-sm font-bold text-coconut-700 shadow-md dark:bg-sun-300 dark:text-husk-500 dark:shadow-lg dark:shadow-sun-400/30">
                  {step.n}
                </span>
                <h3 class="mt-2 text-lg font-semibold text-coconut-700 dark:text-sand-50">
                  {step.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-coconut-400 dark:text-sand-300">
                  {step.body}
                </p>
                <div class="mt-4 rounded-md border border-sand-300 bg-sand-50 px-3 py-2.5 dark:border-husk-50 dark:bg-husk-400">
                  <code class="block font-mono text-xs text-coconut-700 dark:text-sand-100 break-words">
                    {step.example}
                  </code>
                  <p class="mt-1.5 text-xs text-sand-500 dark:text-sand-400">
                    {step.exampleNote}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Help row -->
    <section class="border-b border-sand-300 dark:border-husk-200/80 px-6 py-20 sm:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-2xl">
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-coconut-700 dark:text-sand-50">
            Stuck somewhere?
          </h2>
          <p class="mt-4 text-lg text-coconut-400 dark:text-sand-300">
            Three places to land — pick whichever fits the question.
          </p>
        </div>

        <ul class="mt-12 grid gap-6 md:grid-cols-3">
          {
            helpLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex h-full flex-col rounded-xl border border-palm-300 bg-palm-50 p-6 hover:border-palm-400 hover:bg-palm-100 dark:border-sun-300/40 dark:bg-sun-300/5 dark:hover:border-sun-300/70 dark:hover:bg-sun-300/10 transition"
                >
                  <h3 class="text-lg font-semibold text-coconut-700 dark:text-sand-50">
                    {link.title}
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-coconut-500 dark:text-sand-200 flex-1">
                    {link.body}
                  </p>
                  <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-palm-500 dark:text-sun-300">
                    Go →
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
