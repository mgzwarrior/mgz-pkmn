---
import DocsLayout from "../../components/DocsLayout.astro";

const tabs = [
  {
    title: "Binders",
    body: "The shared home for everything you keep — collections (owned) and wishlists (chasing) both live here as binder rows. See Binders for the full picture.",
    href: "/docs/binders",
  },
  {
    title: "Searches",
    body: "Your named, saved lookups. Click one to rerun it with its results and view restored.",
    href: "/docs/saved-searches",
  },
  {
    title: "Recent",
    body: "A client-side history of inputs you've run, for one-tap re-runs. No account needed — it lives in your browser.",
    href: null,
  },
];
---

<DocsLayout
  title="Backpack — mgz-pkmn docs"
  description="The Backpack is mgz-pkmn's library sidebar: Binders (collections + wishlists), saved Searches, and Recent inputs, plus collection insights. One place for everything you keep."
  current="/docs/backpack"
  icon="backpack"
  accent="ember"
  eyebrow="Your stuff"
  heading="Backpack"
  lede="The Backpack is your library — one sidebar that holds everything you've kept, no matter which way you found it. It sits alongside Swipe, Browse, and Search so saving a card never pulls you out of what you're doing."
>
  <h2 class="mt-2 text-xl font-semibold text-coconut-700 dark:text-sand-50">
    Three tabs
  </h2>
  <ul class="mt-5 space-y-3">
    {
      tabs.map((t) => (
        <li class="rounded-xl border border-sand-300 bg-sand-100 p-4 dark:border-husk-50 dark:bg-husk-200/40">
          <h3 class="text-base font-semibold text-coconut-700 dark:text-sand-50">
            {t.href ? (
              <a href={t.href} class="hover:text-palm-500 dark:hover:text-sun-300">{t.title}</a>
            ) : (
              t.title
            )}
          </h3>
          <p class="mt-1.5 text-sm leading-relaxed text-coconut-500 dark:text-sand-300">{t.body}</p>
        </li>
      ))
    }
  </ul>

  <h2 class="mt-10 text-xl font-semibold text-coconut-700 dark:text-sand-50">
    Roomy or tucked away
  </h2>
  <p class="mt-3 text-sm leading-relaxed text-coconut-500 dark:text-sand-300">
    On a wide screen the Backpack collapses to a slim icon strip when you want the
    space back, and expands when you need it; on a phone it folds into an
    accordion above the editor. The Binders and Searches tabs are tied to your
    account — on the hosted demo they appear once you sign in, and when you
    self-host they're always there.
  </p>

  <div class="mt-10 rounded-xl border border-palm-300 bg-palm-50 p-5 dark:border-sun-300/40 dark:bg-sun-300/5">
    <p class="text-sm leading-relaxed text-coconut-600 dark:text-sand-200">
      The Backpack also surfaces <strong class="font-semibold text-coconut-700 dark:text-sand-50">collection insights</strong> —
      a quick read on what you own and what you're chasing. To keep any of it
      across devices, <a href="/docs/account" class="text-palm-500 hover:text-palm-400 dark:text-sun-300 dark:hover:text-sun-200 underline-offset-4 hover:underline">sign in</a>.
    </p>
  </div>
</DocsLayout>
