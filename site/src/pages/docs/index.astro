---
import DocsLayout from "../../components/DocsLayout.astro";

const cardClass =
  "block rounded-xl border border-sand-300 bg-sand-100 p-5 hover:border-sand-400 dark:border-husk-50 dark:bg-husk-200/40 dark:hover:border-coconut-400 transition";

const sections = [
  {
    heading: "Start here",
    items: [
      {
        href: "/getting-started",
        title: "Getting started",
        body: "The whole loop end to end — paste a wishlist, run the lookup, read the comps, export.",
      },
      {
        href: "/docs/faq",
        title: "FAQ",
        body: "Straight answers to the questions worth asking before you trust a tool with your prep.",
      },
    ],
  },
  {
    heading: "The three ways in",
    items: [
      {
        href: "/docs/swipe",
        title: "Swipe",
        body: "Card at a time. Pass, save, or love each one — and let it learn what you're after.",
      },
      {
        href: "/docs/browse",
        title: "Browse",
        body: "Walk a whole set in order, or every printing of one Pokemon across every set.",
      },
      {
        href: "/docs/search",
        title: "Search",
        body: "Paste a wishlist and get priced results you can export.",
      },
    ],
  },
  {
    heading: "Your stuff",
    items: [
      {
        href: "/docs/backpack",
        title: "Backpack",
        body: "Your library sidebar — binders, saved searches, recent runs, and insights in one place.",
      },
      {
        href: "/docs/wishlists",
        title: "Wishlists",
        body: "Cards you're chasing. One-tap Want, named lists, and an optional price you'd pay.",
      },
      {
        href: "/docs/collections",
        title: "Collections",
        body: "Cards you own — including smart collections built from a saved rule.",
      },
      {
        href: "/docs/binders",
        title: "Binders",
        body: "Where owned and chasing meet: one shelf, filtered and color-coded.",
      },
      {
        href: "/docs/saved-searches",
        title: "Saved searches",
        body: "Name a lookup to keep it, then rerun it against today's market in a click.",
      },
    ],
  },
  {
    heading: "Account & output",
    items: [
      {
        href: "/docs/account",
        title: "Account & sign-in",
        body: "Optional sign-in to keep your stuff across devices — and a plain note on what's stored.",
      },
      {
        href: "/docs/exports",
        title: "Exports",
        body: "Spreadsheet, printable binder, checklist, or JSON — everything you carry to the show.",
      },
    ],
  },
];
---

<DocsLayout
  title="mgz-pkmn docs — how the app works, flow by flow"
  description="Documentation for mgz-pkmn: the three ways in (Swipe, Browse, Search), getting started, and an honest FAQ. Built for collectors."
  current="/docs"
>
  <p
    class="inline-flex items-center gap-2 rounded-full border border-sand-300 bg-sand-100 px-3 py-1 text-xs font-medium text-coconut-500 dark:border-husk-50 dark:bg-husk-200/60 dark:text-sand-200"
  >
    <span class="h-1.5 w-1.5 rounded-full bg-palm-400 dark:bg-sun-300"></span>
    Docs
  </p>

  <h1
    class="mt-6 text-4xl sm:text-5xl font-bold tracking-tight text-coconut-700 dark:text-sand-50 text-balance"
  >
    How mgz-pkmn works.
  </h1>

  <p class="mt-5 text-lg text-coconut-500 dark:text-sand-200">
    The app gives you three ways to find cards — Swipe, Browse, and Search — and
    a shared place to keep what you find. Start with the loop, then dig into
    whichever flow fits how you collect.
  </p>

  <div class="mt-10 space-y-10">
    {
      sections.map((section) => (
        <section>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-sand-500 dark:text-sand-400">
            {section.heading}
          </h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {section.items.map((item) => (
              <a href={item.href} class={cardClass}>
                <h3 class="text-base font-semibold text-coconut-700 dark:text-sand-50">
                  {item.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-coconut-500 dark:text-sand-300">
                  {item.body}
                </p>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</DocsLayout>
