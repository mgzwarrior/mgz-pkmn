---
import DocsLayout from "../../components/DocsLayout.astro";

const demoUrl = "https://mgz-pkmn.onrender.com";

const views = [
  {
    title: "Set view",
    body: "Drill down series → set → cards, in set order. This is how you walk a set: open it and page through every card from 1 to the end, gaps and all.",
  },
  {
    title: "Pokedex view",
    body: "Pivot by national dex number instead — pick a Pokemon and see every printing of it across every set. Built for the species collectors chasing one line.",
  },
];

// Real card art for the illustrative set-grid preview.
const gridCards = [
  "/cards/base1-4.webp",
  "/cards/base1-2.webp",
  "/cards/gym2-2.webp",
  "/cards/ex15-100.webp",
  "/cards/sv8-1.webp",
  "/cards/ru1-7.webp",
  "/cards/pop5-16.webp",
  "/cards/ecard3-H30.webp",
  "/cards/ecard3-H31.webp",
  "/cards/si1-13.webp",
];
---

<DocsLayout
  title="Browse — mgz-pkmn docs"
  description="Browse mode in mgz-pkmn: walk a whole set in order, or pivot to pokedex view to see every printing of one Pokemon, and seed a wishlist from a set."
  current="/docs/browse"
  icon="gallery-horizontal-end"
  accent="palm"
  eyebrow="The three ways in"
  heading="Browse"
  lede="For when you know roughly what you're after — a set you're completing, or one Pokemon you collect everywhere it shows up. Browse lays the cards out so you can see the whole shape of it."
>
  {/* Illustrative UI preview — real card art, annotated. Swap for a real
      screenshot / demo clip once the mobile + desktop UX settles. */}
  <figure
    class="mb-10 overflow-hidden rounded-2xl border border-sand-300 bg-gradient-to-b from-sand-100 to-sand-50 p-6 dark:border-husk-50 dark:from-husk-200/50 dark:to-husk-300/40"
  >
    <div class="flex items-center justify-between gap-3">
      <p class="text-xs font-semibold uppercase tracking-wider text-sand-500 dark:text-sand-400">
        Browse · walk a set
      </p>
      <span
        class="inline-flex items-center gap-1 rounded-full border border-sand-300 bg-sand-50 p-0.5 text-[11px] font-medium dark:border-husk-50 dark:bg-husk-400"
      >
        <span class="rounded-full bg-palm-500 px-2 py-0.5 text-sand-50">Set</span>
        <span class="px-2 py-0.5 text-coconut-500 dark:text-sand-300">Pokédex</span>
      </span>
    </div>
    <div class="mt-4 grid grid-cols-5 gap-2">
      {
        gridCards.map((src, i) => (
          <div class="relative">
            <img
              src={src}
              alt=""
              loading="lazy"
              class="w-full rounded-md shadow-sm ring-1 ring-sand-300/60 dark:ring-white/10"
            />
            {i === 0 && (
              <span class="absolute -right-1 -top-1 inline-flex h-4 w-4 items-center justify-center rounded-full bg-palm-500 text-[9px] font-bold text-sand-50 ring-2 ring-sand-50 dark:ring-husk-400">
                ✓
              </span>
            )}
          </div>
        ))
      }
    </div>
    <figcaption class="mt-5 text-center text-xs text-sand-500 dark:text-sand-400">
      Illustration of set view — the badge marks a card you already own.
    </figcaption>
  </figure>

  <h2 class="mt-2 text-xl font-semibold text-coconut-700 dark:text-sand-50">
    Two ways to organize it
  </h2>
  <p class="mt-3 text-sm leading-relaxed text-coconut-500 dark:text-sand-300">
    A toggle flips the whole panel between two organisations:
  </p>
  <div class="mt-5 grid gap-4 sm:grid-cols-2">
    {
      views.map((v) => (
        <div class="rounded-xl border border-sand-300 bg-sand-100 p-5 dark:border-husk-50 dark:bg-husk-200/40">
          <h3 class="text-base font-semibold text-coconut-700 dark:text-sand-50">{v.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-coconut-500 dark:text-sand-300">{v.body}</p>
        </div>
      ))
    }
  </div>

  <h2 class="mt-10 text-xl font-semibold text-coconut-700 dark:text-sand-50">
    Save as you walk
  </h2>
  <p class="mt-3 text-sm leading-relaxed text-coconut-500 dark:text-sand-300">
    Every card carries the same one-tap actions you'll see everywhere in the app
    — mark it
    <a href="/docs/search" class="text-palm-500 hover:text-palm-400 dark:text-sun-300 dark:hover:text-sun-200 underline-offset-4 hover:underline">wishlist</a>
    (chasing) or owned, and an ownership badge shows what's already in your
    collection. When you're walking a set, the set header's
    <strong class="font-semibold text-coconut-700 dark:text-sand-50">New ▾</strong>
    menu can spin up a wishlist seeded from the entire set, so completing it is
    one action instead of a hundred taps.
  </p>

  <div class="mt-10 rounded-xl border border-palm-300 bg-palm-50 p-5 dark:border-sun-300/40 dark:bg-sun-300/5">
    <p class="text-sm leading-relaxed text-coconut-600 dark:text-sand-200">
      <strong class="font-semibold text-coconut-700 dark:text-sand-50">Tip:</strong>
      Browse pairs well with
      <a href="/docs/search" class="text-palm-500 hover:text-palm-400 dark:text-sun-300 dark:hover:text-sun-200 underline-offset-4 hover:underline">Search</a>
      — seed a wishlist from a set here, then price the whole thing and export a
      binder page. <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="text-palm-500 hover:text-palm-400 dark:text-sun-300 dark:hover:text-sun-200 underline-offset-4 hover:underline">Open the demo</a> and switch to the Browse tab.
    </p>
  </div>
</DocsLayout>
