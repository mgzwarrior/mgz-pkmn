---
import DocsLayout from "../../components/DocsLayout.astro";

const demoUrl = "https://mgz-pkmn.onrender.com";

// Illustrative priced rows for the results-table preview. Comps are
// 80/85/90/95% of market, the same columns the real export carries.
const resultRows = [
  { card: "Charizard", set: "Base · 4/102", market: "$240", comps: ["$192", "$204", "$216", "$228"] },
  { card: "Blastoise", set: "Base · 2/102", market: "$90", comps: ["$72", "$77", "$81", "$86"] },
  { card: "Exeggutor", set: "S. Islands · 13", market: "$40", comps: ["$32", "$34", "$36", "$38"] },
];
const compHeads = ["80%", "85%", "90%", "95%"];
---

<DocsLayout
  title="Search — mgz-pkmn docs"
  description="Search mode in mgz-pkmn: paste a wishlist, look up priced results with market and negotiation comps, save the search, and export to xlsx, binder PDF, checklist, or JSON."
  current="/docs/search"
  icon="search"
  accent="sky"
  eyebrow="The three ways in"
  heading="Search"
  lede="For when you already have a list. Paste a wishlist, hit Look up, and get a priced table back — the same engine the CLI runs, in the browser. This is the flow that ends in an export you carry to the show."
>
  {/* Illustrative UI preview — the priced results table. Swap for a real
      screenshot / demo clip once the mobile + desktop UX settles. */}
  <figure
    class="mb-10 overflow-hidden rounded-2xl border border-sand-300 bg-gradient-to-b from-sand-100 to-sand-50 p-6 dark:border-husk-50 dark:from-husk-200/50 dark:to-husk-300/40"
  >
    <p class="text-xs font-semibold uppercase tracking-wider text-sand-500 dark:text-sand-400">
      Search · results
    </p>
    <div class="mt-4 overflow-hidden rounded-lg border border-sand-300 bg-sand-50 dark:border-husk-50 dark:bg-husk-400">
      <table class="w-full border-collapse text-left text-xs">
        <thead>
          <tr class="border-b border-sand-300 text-coconut-500 dark:border-husk-50 dark:text-sand-300">
            <th class="px-3 py-2 font-semibold">Card</th>
            <th class="px-2 py-2 text-right font-semibold">Market</th>
            {
              compHeads.map((h) => (
                <th class="bg-sun-50 px-2 py-2 text-right font-semibold text-sun-700 dark:bg-sun-400/10 dark:text-sun-300">
                  {h}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            resultRows.map((row) => (
              <tr class="border-b border-sand-200 last:border-0 dark:border-husk-50/60">
                <td class="px-3 py-2">
                  <span class="block font-medium text-coconut-700 dark:text-sand-50">{row.card}</span>
                  <span class="block text-[11px] text-sand-500 dark:text-sand-400">{row.set}</span>
                </td>
                <td class="px-2 py-2 text-right font-semibold text-coconut-700 dark:text-sand-50">
                  {row.market}
                </td>
                {row.comps.map((c) => (
                  <td class="bg-sun-50 px-2 py-2 text-right tabular-nums text-coconut-600 dark:bg-sun-400/10 dark:text-sand-200">
                    {c}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <figcaption class="mt-5 text-center text-xs text-sand-500 dark:text-sand-400">
      Illustration of results — market price, then the highlighted 80/85/90/95% negotiation comps.
    </figcaption>
  </figure>

  <h2 class="mt-2 text-xl font-semibold text-coconut-700 dark:text-sand-50">
    Paste a wishlist
  </h2>
  <p class="mt-3 text-sm leading-relaxed text-coconut-500 dark:text-sand-300">
    Plain text, one card per line. Name a single card, or use a shortcut to pull a
    whole group — set filters and budgets live on the same line.
  </p>
  <div class="mt-4 rounded-md border border-sand-300 bg-sand-50 px-4 py-3 dark:border-husk-50 dark:bg-husk-400">
    <code class="block font-mono text-xs text-coconut-700 dark:text-sand-100">top:5 Charizard | base set</code>
    <p class="mt-1.5 text-xs text-sand-500 dark:text-sand-400">
      The five priciest Charizards from Base Set. The full grammar lives in
      <a href="/getting-started" class="text-palm-500 hover:text-palm-400 dark:text-sun-300 dark:hover:text-sun-200 underline-offset-4 hover:underline">Getting started</a>.
    </p>
  </div>

  <h2 class="mt-10 text-xl font-semibold text-coconut-700 dark:text-sand-50">
    Read the results
  </h2>
  <p class="mt-3 text-sm leading-relaxed text-coconut-500 dark:text-sand-300">
    Each matched card comes back with its market price and four negotiation comps
    — 80%, 85%, 90%, and 95% of market — so you walk in knowing your floor and
    your ceiling. Pricing runs card by card with a determinate progress bar; you
    always know how far along it is.
  </p>

  <h2 class="mt-10 text-xl font-semibold text-coconut-700 dark:text-sand-50">
    Save it, export it
  </h2>
  <p class="mt-3 text-sm leading-relaxed text-coconut-500 dark:text-sand-300">
    Export lives in the results — it only applies to matched rows, which is why
    Browse and Swipe don't surface it. Take the list out as a spreadsheet, a 3×3
    printable binder PDF, a checklist, or raw JSON. You can also save the search
    itself to your <a href="/docs/swipe" class="text-palm-500 hover:text-palm-400 dark:text-sun-300 dark:hover:text-sun-200 underline-offset-4 hover:underline">Backpack</a>
    to rerun it later.
  </p>

  <div class="mt-10 rounded-xl border border-palm-300 bg-palm-50 p-5 dark:border-sun-300/40 dark:bg-sun-300/5">
    <p class="text-sm leading-relaxed text-coconut-600 dark:text-sand-200">
      <strong class="font-semibold text-coconut-700 dark:text-sand-50">See it end to end:</strong>
      <a href="/getting-started" class="text-palm-500 hover:text-palm-400 dark:text-sun-300 dark:hover:text-sun-200 underline-offset-4 hover:underline">Getting started</a>
      walks the full loop, or <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="text-palm-500 hover:text-palm-400 dark:text-sun-300 dark:hover:text-sun-200 underline-offset-4 hover:underline">open the demo</a> and switch to the Search tab.
    </p>
  </div>
</DocsLayout>
