---
import { fetchRoadmapMilestones, type RoadmapState } from "../lib/github.ts";
import { renderInlineMarkdown } from "../lib/changelog.ts";

interface Milestone {
  label: string;
  state: RoadmapState;
  /** HTML-safe body markup (already run through `renderInlineMarkdown`). */
  body: string;
  href: string;
}

// Hard-coded fallback used when the GitHub milestones API is unreachable
// at build time, or returns fewer than three usable milestones. Mirrors
// the changelog helper's "fail open, build still succeeds" pattern.
// Bodies are passed through `renderInlineMarkdown` alongside the live
// data so any inline links / code / bold render consistently.
const fallbackRaw: { label: string; state: RoadmapState; body: string; href: string }[] = [
  {
    label: "1.7 — Shipped",
    state: "done",
    body: "Collector-facing web surfaces: swipe triage, browse-a-set, saved searches, wishlists, collections, and printable binders.",
    href: "https://github.com/mgzwarrior/mgz-pkmn/milestone/11",
  },
  {
    label: "1.8 — In flight",
    state: "active",
    body: "Make it honest — every surface that explains the app brought back in sync with what it ships, plus the first end-to-end smoke tests and a collector-facing front door.",
    href: "https://github.com/mgzwarrior/mgz-pkmn/milestone/12",
  },
  {
    label: "1.9 — Next up",
    state: "planned",
    body: "Web workspace rethink: a real library identity (saved searches vs. wishlists vs. collections), a mobile-first IA, and export / filter / pricing-column upgrades.",
    href: "https://github.com/mgzwarrior/mgz-pkmn/milestone/13",
  },
];
const fallback: Milestone[] = fallbackRaw.map((m) => ({
  ...m,
  body: renderInlineMarkdown(m.body),
}));

const stateSuffix: Record<RoadmapState, string> = {
  done: "Shipped",
  active: "In flight",
  planned: "Planned",
};

const stateFallbackBody: Record<RoadmapState, string> = {
  done: "Shipped. See the milestone for the changelog.",
  active: "Currently in flight. See the milestone for open work.",
  planned: "Up next. See the milestone for the planned scope.",
};

const dynamic = await fetchRoadmapMilestones();
const milestones: Milestone[] = dynamic
  ? dynamic.map((m) => ({
      label: `${m.title} — ${stateSuffix[m.state]}`,
      state: m.state,
      // Milestone descriptions support the same inline-markdown subset as
      // changelog bullets ([text](url), `code`, **bold**); render through
      // the shared helper so links land as <a>, not literal `[text](url)`.
      body: renderInlineMarkdown(m.body ?? stateFallbackBody[m.state]),
      href: m.url,
    }))
  : fallback;

const stateStyle = {
  done: "bg-palm-50 text-palm-600 border-palm-200 dark:bg-palm-500/15 dark:text-palm-200 dark:border-palm-500/30",
  active: "bg-sun-100 text-sun-700 border-sun-200 dark:bg-sun-400/15 dark:text-sun-300 dark:border-sun-400/30",
  planned: "bg-sand-200 text-coconut-500 border-sand-300 dark:bg-husk-100/60 dark:text-sand-200 dark:border-coconut-500",
};
---

<section
  id="roadmap"
  class="border-b border-sand-300 dark:border-husk-200/80 px-6 py-20 sm:py-24"
>
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <h2
        class="text-3xl sm:text-4xl font-bold tracking-tight text-coconut-700 dark:text-sand-50"
      >
        Where it's going.
      </h2>
      <p class="mt-4 text-lg text-coconut-400 dark:text-sand-300">
        Roadmap organized by area — lookup, outputs, cache, web, devops. Speculative
        ideas live in the full roadmap; the committed work is below.
      </p>
    </div>

    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        milestones.map((m) => (
          <li class="flex flex-col rounded-xl border border-sand-300 bg-sand-100 p-6 shadow-xs dark:border-husk-50 dark:bg-husk-200/40 dark:shadow-none">
            <span
              class={`self-start rounded-full border px-3 py-1 text-xs font-semibold ${stateStyle[m.state]}`}
            >
              {m.label}
            </span>
            <p
              class="mt-4 text-sm leading-relaxed text-coconut-400 dark:text-sand-300 flex-1"
              set:html={m.body}
            />

            <a
              href={m.href}
              class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-palm-500 hover:text-palm-400 dark:text-sun-300 dark:hover:text-sun-200"
            >
              View milestone →
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 text-sm text-sand-500 dark:text-sand-400">
      Full roadmap (the committed minors plus the speculative Backlog) lives in the
      <a
        href="https://github.com/mgzwarrior/mgz-pkmn/blob/main/docs/roadmap.md"
        class="text-coconut-500 dark:text-sand-200 underline-offset-4 hover:underline">repo</a
      >.
    </p>
  </div>
</section>
