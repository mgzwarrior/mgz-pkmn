---
const milestones = [
  {
    label: "1.0 — Shipped",
    state: "done",
    body: "Multi-source lookup, full output suite, web UI, complete release engineering. The defensible 1.0 with no obvious gaps.",
    href: "https://github.com/mgzwarrior/mgz-pkmn/milestone/1",
  },
  {
    label: "1.1 — In flight",
    state: "active",
    body: "Polish and on-ramp: starter-issue curation, CITATION.cff, docs troubleshooting, py.typed marker, Discussions visibility. Open to first-time contributors.",
    href: "https://github.com/mgzwarrior/mgz-pkmn/milestone/2",
  },
  {
    label: "2.0 — Next major",
    state: "planned",
    body: "Structured query DSL, eBay sold-listings, type-aware search, LRU cache with eviction, persistent run history, PyPI + Docker publishing, OpenAPI client codegen.",
    href: "https://github.com/mgzwarrior/mgz-pkmn/milestone/3",
  },
];

const stateStyle = {
  done: "bg-emerald-500/15 text-emerald-300 border-emerald-500/30",
  active: "bg-brand-500/15 text-brand-400 border-brand-500/30",
  planned: "bg-zinc-800/60 text-zinc-300 border-zinc-700",
};
---

<section id="roadmap" class="border-b border-zinc-900/80 px-6 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
        Where it's going.
      </h2>
      <p class="mt-4 text-lg text-zinc-400">
        Roadmap organized by area — lookup, outputs, cache, web, devops. Speculative
        ideas live in the full roadmap; the committed work is below.
      </p>
    </div>

    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        milestones.map((m) => (
          <li class="flex flex-col rounded-xl border border-zinc-800 bg-zinc-900/40 p-6">
            <span
              class={`self-start rounded-full border px-3 py-1 text-xs font-semibold ${stateStyle[m.state as keyof typeof stateStyle]}`}
            >
              {m.label}
            </span>
            <p class="mt-4 text-sm leading-relaxed text-zinc-400 flex-1">{m.body}</p>
            <a
              href={m.href}
              class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-400 hover:text-brand-300"
            >
              View milestone →
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 text-sm text-zinc-500">
      Full roadmap (including post-V2 monetization and V3+ proposals) lives in the
      <a
        href="https://github.com/mgzwarrior/mgz-pkmn/blob/main/docs/roadmap.md"
        class="text-zinc-300 underline-offset-4 hover:underline">repo</a
      >.
    </p>
  </div>
</section>
