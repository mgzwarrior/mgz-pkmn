---
const milestones = [
  {
    label: "1.1 — Shipped",
    state: "done",
    body: "Polish and on-ramp: starter-issue curation, CITATION.cff, docs troubleshooting, py.typed marker, Discussions visibility, cache subcommands. Open to first-time contributors.",
    href: "https://github.com/mgzwarrior/mgz-pkmn/milestone/2",
  },
  {
    label: "1.2 — In flight",
    state: "active",
    body: "Persistence foundation and web/site polish. Bridges v1.1's devex work and v2.0's deeper architectural changes.",
    href: "https://github.com/mgzwarrior/mgz-pkmn/milestone/4",
  },
  {
    label: "2.0 — Next major",
    state: "planned",
    body: "Structured query DSL, eBay sold-listings, type-aware search, LRU cache with eviction, persistent run history, PyPI + Docker publishing, OpenAPI client codegen.",
    href: "https://github.com/mgzwarrior/mgz-pkmn/milestone/3",
  },
];

const stateStyle = {
  done: "bg-palm-50 text-palm-600 border-palm-200 dark:bg-palm-500/15 dark:text-palm-200 dark:border-palm-500/30",
  active: "bg-sun-100 text-sun-700 border-sun-200 dark:bg-sun-400/15 dark:text-sun-300 dark:border-sun-400/30",
  planned: "bg-sand-200 text-coconut-500 border-sand-300 dark:bg-husk-100/60 dark:text-sand-200 dark:border-coconut-500",
};
---

<section
  id="roadmap"
  class="border-b border-sand-300 dark:border-husk-200/80 px-6 py-20 sm:py-24"
>
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <h2
        class="text-3xl sm:text-4xl font-bold tracking-tight text-coconut-700 dark:text-sand-50"
      >
        Where it's going.
      </h2>
      <p class="mt-4 text-lg text-coconut-400 dark:text-sand-300">
        Roadmap organized by area — lookup, outputs, cache, web, devops. Speculative
        ideas live in the full roadmap; the committed work is below.
      </p>
    </div>

    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        milestones.map((m) => (
          <li class="flex flex-col rounded-xl border border-sand-300 bg-sand-100 p-6 shadow-xs dark:border-husk-50 dark:bg-husk-200/40 dark:shadow-none">
            <span
              class={`self-start rounded-full border px-3 py-1 text-xs font-semibold ${stateStyle[m.state as keyof typeof stateStyle]}`}
            >
              {m.label}
            </span>
            <p class="mt-4 text-sm leading-relaxed text-coconut-400 dark:text-sand-300 flex-1">{m.body}</p>
            <a
              href={m.href}
              class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-palm-500 hover:text-palm-400 dark:text-sun-300 dark:hover:text-sun-200"
            >
              View milestone →
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 text-sm text-sand-500 dark:text-sand-400">
      Full roadmap (including post-V2 monetization and V3+ proposals) lives in the
      <a
        href="https://github.com/mgzwarrior/mgz-pkmn/blob/main/docs/roadmap.md"
        class="text-coconut-500 dark:text-sand-200 underline-offset-4 hover:underline">repo</a
      >.
    </p>
  </div>
</section>
