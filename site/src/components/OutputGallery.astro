---
// The spreadsheet is landscape, so it gets a dedicated full-width card; the
// two PDFs are portrait and sit in a row beneath it.
const spreadsheet = {
  src: "/screenshots/cards-xlsx.webp",
  title: "Spreadsheet",
  caption:
    "Per-tag sections, thumbnails inline, market price and your 80 / 85 / 90 / 95 % comps on every row — with a totals row at the bottom.",
  alt: "Screenshot of the generated cards.xlsx workbook showing card rows with thumbnails, set, number, market price, comparison columns, and a totals row.",
  suffix: "cards.xlsx",
};

const pdfs = [
  {
    src: "/screenshots/binder-page.webp",
    title: "Binder PDF",
    caption:
      "Printable 3×3 binder page — thumb, set, number, price. Hand it across the table.",
    alt: "Screenshot of a single page from the generated binder.pdf showing a 3×3 grid of Pokémon TCG cards with prices.",
    suffix: "binder.pdf",
  },
  {
    src: "/screenshots/checklist-page.webp",
    title: "Checklist PDF",
    caption:
      "Tick boxes by set, in collector-number order. Drop it in your binder and shop.",
    alt: "Screenshot of a single page from the generated checklist.pdf listing cards by set with checkbox marks.",
    suffix: "checklist.pdf",
  },
];

const cardClass =
  "flex flex-col rounded-xl border border-sand-300 bg-sand-100 shadow-xs overflow-hidden hover:border-sand-400 hover:shadow-md dark:border-husk-50 dark:bg-husk-200/40 dark:shadow-none dark:hover:border-coconut-400 transition";
---

<section
  id="what-you-get"
  class="border-b border-sand-300 dark:border-husk-200/80 px-6 py-20 sm:py-24"
>
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-coconut-700 dark:text-sand-50">
        What you actually walk out with.
      </h2>
      <p class="mt-4 text-lg text-coconut-400 dark:text-sand-300">
        Every run produces the same three artifacts — pick the format that fits the
        moment. Screenshots below are rendered from the tracked sample outputs in
        <code class="text-coconut-500 dark:text-sand-200 font-mono text-base">output/</code>.
      </p>
    </div>

    <div class="mt-12 flex flex-col gap-6">
      <article class={cardClass}>
        <div class="bg-sand-200 dark:bg-husk-500/60 overflow-hidden">
          <img
            src={spreadsheet.src}
            alt={spreadsheet.alt}
            loading="lazy"
            decoding="async"
            class="block w-full h-auto"
          />
        </div>
        <div class="p-5">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="text-lg font-semibold text-coconut-700 dark:text-sand-50">{spreadsheet.title}</h3>
            <code class="text-xs text-sand-500 dark:text-sand-400 font-mono">{spreadsheet.suffix}</code>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-coconut-400 dark:text-sand-300">
            {spreadsheet.caption}
          </p>
        </div>
      </article>

      <ul class="grid gap-6 sm:grid-cols-2">
        {
          pdfs.map((output) => (
            <li class={cardClass}>
              <div class="bg-sand-200 dark:bg-husk-500/60 aspect-[5/6] overflow-hidden flex items-start justify-center">
                <img
                  src={output.src}
                  alt={output.alt}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto object-cover object-top"
                />
              </div>
              <div class="p-5">
                <div class="flex items-baseline justify-between gap-3">
                  <h3 class="text-lg font-semibold text-coconut-700 dark:text-sand-50">{output.title}</h3>
                  <code class="text-xs text-sand-500 dark:text-sand-400 font-mono">{output.suffix}</code>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-coconut-400 dark:text-sand-300">
                  {output.caption}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
