---
// Interest-gathering only — no vendor features exist yet (#801). A plain
// mailto keeps it backend-free; replies land in the maintainer's inbox so
// the demand signal is reviewable without standing up a form provider.
const mailtoSubject = encodeURIComponent("Vendor / LGS interest in mgz-pkmn");
const mailtoBody = encodeURIComponent(
  "Hi Matt — I run a shop / sell at shows and a tool like this could help because:\n\n",
);
const mailtoHref = `mailto:mattgrant33@gmail.com?subject=${mailtoSubject}&body=${mailtoBody}`;
---

<section
  id="vendors"
  class="border-b border-sand-300 dark:border-husk-200/80 px-6 py-16 sm:py-20"
>
  <div
    class="mx-auto max-w-3xl rounded-xl border border-sand-300 bg-sand-100 p-6 sm:p-8 dark:border-husk-50 dark:bg-husk-200/40"
  >
    <p
      class="inline-flex items-center gap-2 rounded-full border border-sand-300 bg-sand-50 px-3 py-1 text-xs font-medium text-coconut-500 dark:border-husk-50 dark:bg-husk-200/60 dark:text-sand-200"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-sun-300"></span>
      For vendors &amp; shops
    </p>

    <h2
      class="mt-4 text-2xl sm:text-3xl font-bold tracking-tight text-coconut-700 dark:text-sand-50 text-balance"
    >
      Run a shop or a table at shows?
    </h2>

    <p class="mt-3 text-base leading-relaxed text-coconut-500 dark:text-sand-300">
      Right now mgz-pkmn is built for collectors — there's no vendor or storefront
      tooling yet, and I haven't started any. Before I build something nobody asked
      for, I'm trying to learn whether it's wanted at all. If you sell cards and a
      tool like this would help your booth or shop, I'd genuinely like to hear from
      you. Nothing's built — this is just me asking.
    </p>

    <a
      href={mailtoHref}
      class="mt-6 inline-flex items-center gap-2 rounded-md bg-sun-300 px-5 py-3 text-sm font-semibold text-coconut-700 shadow-md hover:bg-sun-400 dark:bg-sun-300 dark:text-husk-500 dark:shadow-lg dark:shadow-sun-400/20 dark:hover:bg-sun-200 transition"
    >
      Tell me you're interested
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M22 2 11 13" /><path d="M22 2 15 22l-4-9-9-4 20-7z" />
      </svg>
    </a>
  </div>
</section>
