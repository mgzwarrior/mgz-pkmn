---
// Light/dark toggle. Dark (the original palette) is the default; light is the
// tropical theme. The icon shown reflects the theme you'd switch *to*.
---

<button
  type="button"
  data-theme-toggle
  aria-label="Toggle color theme"
  title="Toggle color theme"
  class="inline-flex h-9 w-9 items-center justify-center rounded-md text-coconut-500 hover:text-coconut-700 hover:bg-sand-100 dark:text-sand-200 dark:hover:text-sand-50 dark:hover:bg-husk-100 transition"
>
  {/* Sun — shown in dark mode (click to go light) */}
  <svg
    class="hidden h-5 w-5 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>
  {/* Moon — shown in light mode (click to go dark) */}
  <svg
    class="block h-5 w-5 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script is:inline>
  // Delegated + guarded so the toggle works no matter how many times this
  // component is rendered (e.g. the header bar and the mobile drawer both
  // carry one). Binding on document once avoids duplicate-id pitfalls.
  (function () {
    if (window.__themeToggleBound) return;
    window.__themeToggleBound = true;
    document.addEventListener("click", function (event) {
      if (!event.target.closest("[data-theme-toggle]")) return;
      var isDark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch (e) {}
    });
  })();
</script>
