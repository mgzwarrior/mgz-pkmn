---
const demoUrl = "https://mgz-pkmn.onrender.com";
const repoUrl = "https://github.com/mgzwarrior/mgz-pkmn";
---

<section
  class="relative overflow-hidden border-b border-zinc-900/80 px-6 py-20 sm:py-28"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_70%)]"
  >
    <div
      class="absolute inset-x-0 top-0 mx-auto h-[40rem] w-[40rem] -translate-y-1/3 rounded-full bg-brand-600/15 blur-3xl"
    >
    </div>
  </div>

  <div class="mx-auto max-w-4xl text-center">
    <p
      class="inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-zinc-900/60 px-3 py-1 text-xs font-medium text-zinc-300"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span>
      Now shipping 1.1.1
    </p>

    <h1
      class="mt-6 text-4xl sm:text-6xl font-bold tracking-tight text-white text-balance"
    >
      Walk into your next card show with a plan, not a hope.
    </h1>

    <p class="mt-6 text-lg sm:text-xl text-zinc-300 text-balance max-w-2xl mx-auto">
      <strong class="text-white">mgz-pkmn</strong> turns a list of cards you want into a
      printable binder with thumbnails, market prices, and your negotiation floor. Built
      for collectors who'd rather show up informed than wing it on convention center
      Wi-Fi.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a
        href={demoUrl}
        class="inline-flex items-center gap-2 rounded-md bg-brand-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/20 hover:bg-brand-400 transition"
      >
        Try the live demo
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 17 17 7" /><path d="M7 7h10v10" />
        </svg>
      </a>
      <a
        href={repoUrl}
        class="inline-flex items-center gap-2 rounded-md border border-zinc-800 bg-zinc-900/60 px-5 py-3 text-sm font-semibold text-zinc-100 hover:bg-zinc-900 hover:border-zinc-700 transition"
      >
        View on GitHub
      </a>
    </div>
  </div>

  <div class="mx-auto mt-16 max-w-3xl">
    <pre
      class="overflow-x-auto rounded-lg border border-zinc-800 bg-zinc-950/80 p-5 text-sm text-zinc-200 font-mono"><code><span class="text-zinc-500"># 1. Write your want-list</span>
<span class="text-zinc-300">$ cat input/wants.txt</span>
top 5 Mew cards under $50
all Charizard cards | japanese
rest of Surging Sparks

<span class="text-zinc-500"># 2. Run the tool</span>
<span class="text-zinc-300">$ pkmn lookup input/ -o output/cards.xlsx \
    --pdf output/binder.pdf --checklist output/checklist.pdf</span>

<span class="text-brand-400">→ output/cards.xlsx, binder.pdf, checklist.pdf</span></code></pre>
  </div>
</section>
