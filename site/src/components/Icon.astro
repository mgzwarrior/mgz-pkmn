---
// Inlined Lucide icons (https://lucide.dev, ISC). The design system mandates
// Lucide at 1.75 stroke; these are the exact official paths so no runtime dep
// is needed for the static site. Add new glyphs by pasting their Lucide inner
// markup here. Icon meanings mirror the app's own choices where they overlap
// (Swipe=Layers, Browse=GalleryHorizontalEnd, Wishlist=Footprints, etc.).
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = "h-5 w-5" } = Astro.props;

const icons: Record<string, string> = {
  compass:
    '<circle cx="12" cy="12" r="10"/><path d="m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z"/>',
  "book-open":
