---
// Newsletter signup — posts to our own API (ADR-0028), which creates a Resend
// contact stamped with the chosen reason. A single Resend Automation branches
// on that reason to send one of three 3-email welcome tracks.
//
// API origin matches site/src/lib/changelog.ts: `MGZ_PKMN_API_BASE` overrides
// it (handy for building against a local API), defaulting to the public demo.
const API_BASE =
  process.env.MGZ_PKMN_API_BASE?.replace(/\/$/, "") ||
  "https://mgz-pkmn.onrender.com";
const subscribeUrl = `${API_BASE}/api/v1/subscribe`;

// Reason chips → the `reason` the API stamps onto the Resend contact. Keep the
// values in sync with the Literal in api/routes/subscribe.py and the
// Automation's branch conditions.
const reasons = [
  { value: "collector", label: "Collector", hint: "I collect cards" },
  { value: "show", label: "Show prep", hint: "I buy/sell at shows" },
  { value: "builder", label: "Builder", hint: "I'm here for the code" },
];
---

<section
  id="signup"
  class="border-b border-sand-300 dark:border-husk-200/80 px-6 py-20 sm:py-24"
>
  <div class="mx-auto max-w-3xl text-center">
    <p
      class="inline-flex items-center gap-2 rounded-full border border-sand-300 bg-sand-100 backdrop-blur px-3 py-1 text-xs font-medium text-coconut-500 dark:border-husk-50 dark:bg-husk-200/60 dark:text-sand-200"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-sun-300 dark:bg-sun-300"></span>
      Newsletter
    </p>

    <h2
      class="mt-6 text-3xl sm:text-4xl font-bold tracking-tight text-coconut-700 dark:text-sand-50 text-balance"
    >
      Get the next release in your inbox.
    </h2>

    <p
      class="mt-4 text-lg text-coconut-500 dark:text-sand-300 max-w-xl mx-auto text-balance"
    >
      Tell us why you're here and we'll send a short welcome that fits — then the
      odd note when a new version ships. No spam, unsubscribe anytime.
    </p>

    <form
      id="email-signup-form"
      action={subscribeUrl}
      method="post"
      class="mt-8 flex flex-col gap-4 max-w-md mx-auto"
    >
      <fieldset class="flex flex-col gap-2">
        <legend class="text-sm font-medium text-coconut-600 dark:text-sand-200">
          I'm here as a…
        </legend>
        <div class="grid grid-cols-3 gap-2">
          {
            reasons.map((r, i) => (
              <label class="group flex cursor-pointer flex-col items-center gap-0.5 rounded-md border border-sand-300 bg-sand-50 px-2 py-2.5 text-center transition has-[:checked]:border-palm-400 has-[:checked]:bg-palm-50 has-[:checked]:ring-2 has-[:checked]:ring-palm-300/40 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-palm-300/60 dark:border-husk-50 dark:bg-husk-200/60 dark:has-[:checked]:border-sun-300 dark:has-[:checked]:bg-husk-100 dark:has-[:checked]:ring-sun-400/30">
                <input
                  type="radio"
                  name="reason"
                  value={r.value}
                  checked={i === 0}
                  class="sr-only"
                />
                <span class="text-sm font-semibold text-coconut-700 dark:text-sand-50">
                  {r.label}
                </span>
                <span class="text-xs text-coconut-400 dark:text-sand-300">
                  {r.hint}
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="flex flex-col sm:flex-row gap-3">
        <label for="signup-email" class="sr-only">Email address</label>
        <input
          id="signup-email"
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class="flex-1 rounded-md border border-sand-300 bg-sand-50 px-4 py-3 text-sm text-coconut-700 placeholder:text-coconut-400 focus:outline-none focus:border-palm-400 focus:ring-2 focus:ring-palm-300/40 dark:border-husk-50 dark:bg-husk-200/60 dark:text-sand-50 dark:placeholder:text-sand-400 dark:focus:border-sun-300 dark:focus:ring-sun-400/30 transition"
        />
        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 rounded-md bg-sun-300 px-5 py-3 text-sm font-semibold text-coconut-700 shadow-md hover:bg-sun-400 dark:bg-sun-300 dark:text-husk-500 dark:shadow-lg dark:shadow-sun-400/20 dark:hover:bg-sun-200 transition disabled:opacity-60 disabled:cursor-not-allowed"
          data-default-label="Subscribe"
        >
          <span data-label>Subscribe</span>
        </button>
      </div>
    </form>

    <p
      id="email-signup-status"
      role="status"
      aria-live="polite"
      class="mt-4 min-h-[1.5rem] text-sm"
    >
    </p>

    <noscript>
      <p class="mt-4 text-sm text-coconut-400 dark:text-sand-300">
        Signing up needs JavaScript. Prefer not to? Email
        <a
          href="mailto:mattgrant33@gmail.com?subject=mgz-pkmn%20newsletter"
          class="text-palm-500 hover:text-palm-400 dark:text-sun-300 dark:hover:text-sun-200 underline-offset-4 hover:underline"
          >mattgrant33@gmail.com</a
        >
        and say which track you'd like.
      </p>
    </noscript>
  </div>
</section>

<script is:inline>
  // Progressive enhancement: submit to the API via fetch and surface inline
  // success/error feedback so the visitor never leaves the page. Unlike the old
  // Buttondown embed, this endpoint returns a real status, so the messaging can
  // be honest about whether the signup actually landed. The endpoint is a JSON
  // API (no urlencoded form fallback), so a no-JS submit is handled by the
  // <noscript> note above rather than a broken native POST.
  (function () {
    const form = document.getElementById("email-signup-form");
    if (!form) return;
    const status = document.getElementById("email-signup-status");
    const button = form.querySelector("button[type=submit]");
    const labelEl = button && button.querySelector("[data-label]");
    const input = form.querySelector("input[name=email]");

    function setStatus(text, tone) {
      if (!status) return;
      status.textContent = text;
      status.dataset.tone = tone;
      // Tone-driven color: success (palm), error (ember), neutral (coconut).
      status.className =
        "mt-4 min-h-[1.5rem] text-sm " +
        (tone === "success"
          ? "text-palm-500 dark:text-palm-200 font-medium"
          : tone === "error"
            ? "text-ember-500 dark:text-ember-300 font-medium"
            : "text-coconut-400 dark:text-sand-300");
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!input || !input.value) return;
      const checked = form.querySelector("input[name=reason]:checked");
      const reason = checked ? checked.value : "collector";

      button.disabled = true;
      if (labelEl) labelEl.textContent = "Subscribing…";
      setStatus("", "neutral");

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: input.value, reason }),
        });
        if (response.ok) {
          setStatus(
            "You're in — check your inbox for a welcome note. See you at the next release.",
            "success",
          );
          form.reset();
        } else if (response.status === 422) {
          setStatus("That email looks off — give it another try.", "error");
        } else {
          // 503 (signups not configured) or 502 (Resend hiccup): same recovery.
          setStatus(
            "Couldn't sign you up just now. Try again in a bit, or email mattgrant33@gmail.com.",
            "error",
          );
        }
      } catch (err) {
        setStatus(
          "Couldn't reach the server. Try again, or email mattgrant33@gmail.com.",
          "error",
        );
      } finally {
        button.disabled = false;
        if (labelEl) labelEl.textContent = button.dataset.defaultLabel;
      }
    });
  })();
</script>
