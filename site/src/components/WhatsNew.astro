---
import { fetchReleases, renderInlineMarkdown } from "../lib/changelog.ts";

// Pulled at build time from the API's /api/v1/changelog endpoint (the same
// source the demo SPA reads). Returns [] if the API is unreachable, in
// which case the whole section is skipped below.
const releases = await fetchReleases(3);
const repoChangelogUrl =
  "https://github.com/mgzwarrior/mgz-pkmn/blob/main/CHANGELOG.md";

// Friendly date: "2026-05-25" → "May 25, 2026". Falls back to the raw
// string if it doesn't parse.
function formatDate(iso: string | null): string {
  if (!iso) return "";
  const d = new Date(`${iso}T00:00:00Z`);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
}

const sectionAccent: Record<string, string> = {
  Added: "text-emerald-600 border-emerald-600/30 dark:text-emerald-400 dark:border-emerald-400/30",
  Changed: "text-sky-600 border-sky-600/30 dark:text-sky-400 dark:border-sky-400/30",
  Fixed: "text-amber-600 border-amber-600/30 dark:text-amber-400 dark:border-amber-400/30",
  Removed: "text-rose-600 border-rose-600/30 dark:text-rose-400 dark:border-rose-400/30",
  Deprecated: "text-orange-600 border-orange-600/30 dark:text-orange-400 dark:border-orange-400/30",
  Security: "text-violet-600 border-violet-600/30 dark:text-violet-400 dark:border-violet-400/30",
};
---

{
  releases.length > 0 && (
    <section
      id="whats-new"
      class="border-b border-sand-300 dark:border-zinc-900/80 px-6 py-20 sm:py-24"
    >
      <div class="mx-auto max-w-4xl">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div class="max-w-2xl">
            <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-coconut-700 dark:text-white">
              Recently shipped.
            </h2>
            <p class="mt-4 text-lg text-coconut-400 dark:text-zinc-400">
              The last few releases at a glance — straight from the changelog.
            </p>
          </div>
          <a
            href={repoChangelogUrl}
            class="text-sm font-semibold text-palm-500 hover:text-palm-400 dark:text-blue-400 dark:hover:text-blue-300 transition"
            target="_blank"
            rel="noopener noreferrer"
          >
            Full changelog →
          </a>
        </div>

        <ol class="mt-12 space-y-10">
          {releases.map((release) => (
            <li class="relative border-l border-sand-300 dark:border-zinc-800 pl-6">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="text-xl font-semibold text-coconut-700 dark:text-white">
                  v{release.version}
                </h3>
                {release.date && (
                  <time class="text-sm text-sand-500 dark:text-zinc-500">
                    {formatDate(release.date)}
                  </time>
                )}
              </div>

              <div class="mt-4 space-y-5">
                {release.sections.map((section) => (
                  <div>
                    <span
                      class={`inline-block rounded-full border px-2.5 py-0.5 text-xs font-medium ${
                        sectionAccent[section.name] ??
                        "text-coconut-400 border-sand-300 dark:text-zinc-400 dark:border-zinc-700"
                      }`}
                    >
                      {section.name}
                    </span>
                    <ul class="mt-3 space-y-2">
                      {section.entries.map((entry) => (
                        <li class="flex gap-2.5 text-sm leading-relaxed text-coconut-500 dark:text-zinc-300">
                          <span
                            aria-hidden="true"
                            class="mt-2 h-1 w-1 shrink-0 rounded-full bg-sand-400 dark:bg-zinc-600"
                          />
                          <span set:html={renderInlineMarkdown(entry)} />
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}
