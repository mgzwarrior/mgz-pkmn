---
import logoLightUrl from "../../../assets/logo.svg?url";
import logoDarkUrl from "../../../assets/logo-dark.svg?url";
import ebayLogoUrl from "../../../assets/marketplaces/ebay.svg?url";
import tcgplayerLogoUrl from "../../../assets/marketplaces/tcgplayer.svg?url";

const year = new Date().getFullYear();
const links = {
  Project: [
    { label: "GitHub", href: "https://github.com/mgzwarrior/mgz-pkmn" },
    { label: "Live demo", href: "https://mgz-pkmn.onrender.com" },
    { label: "Roadmap", href: "https://github.com/mgzwarrior/mgz-pkmn/blob/main/docs/roadmap.md" },
    { label: "For vendors", href: "/#vendors" },
  ],
  Community: [
    { label: "Discussions", href: "https://github.com/mgzwarrior/mgz-pkmn/discussions" },
    { label: "Issues", href: "https://github.com/mgzwarrior/mgz-pkmn/issues" },
    {
      label: "Good first issue",
      href: "https://github.com/mgzwarrior/mgz-pkmn/labels/good%20first%20issue",
    },
  ],
  Support: [
    { label: "Buy me a pizza", href: "https://www.buymeacoffee.com/mgz.pkmn" },
  ],
  Docs: [
    {
      label: "Getting started",
      href: "/getting-started",
    },
    {
      label: "CLI reference",
      href: "https://github.com/mgzwarrior/mgz-pkmn/blob/main/docs/cli.md",
    },
    {
      label: "Contributing",
      href: "https://github.com/mgzwarrior/mgz-pkmn/blob/main/docs/contributing.md",
    },
    {
      label: "Wiki",
      href: "https://github.com/mgzwarrior/mgz-pkmn/wiki",
    },
  ],
};
---

<footer class="px-6 py-16">
  <div class="mx-auto max-w-6xl grid gap-10 md:grid-cols-5">
    <div>
      <img
        src={logoLightUrl}
        alt="mgz-pkmn"
        width="180"
        height="44"
        class="h-9 w-auto dark:hidden"
      />
      <img
        src={logoDarkUrl}
        alt="mgz-pkmn"
        width="180"
        height="44"
        class="hidden h-9 w-auto dark:block"
      />
      <p class="mt-4 text-sm text-coconut-400 dark:text-sand-300 max-w-xs">
        Open-source prep tool for Pokemon card show buyers and sellers. MIT licensed.
      </p>
    </div>

    {
      Object.entries(links).map(([heading, items]) => (
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider text-sand-500 dark:text-sand-400">
            {heading}
          </h4>
          <ul class="mt-4 space-y-2 text-sm">
            {items.map((item) => (
              <li>
                <a href={item.href} class="text-coconut-500 hover:text-coconut-700 dark:text-sand-200 dark:hover:text-sand-50 transition">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div
    class="mx-auto mt-12 max-w-6xl border-t border-sand-300 dark:border-husk-200 pt-6 text-xs text-sand-500 dark:text-sand-400"
  >
    <div class="flex flex-wrap items-center justify-between gap-3">
      <span>© {year} Matt Grant. Released under the MIT License.</span>
      <span>
        Built by
        <a
          href="https://github.com/mgzwarrior"
          class="text-coconut-400 hover:text-coconut-700 dark:text-sand-300 dark:hover:text-sand-50 transition">@mgzwarrior</a
        >.
      </span>
    </div>
    <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-sand-200 pt-4 dark:border-husk-100">
      <p class="max-w-2xl leading-relaxed">
        Affiliate disclosure: mgz-pkmn may earn from qualifying purchases through eBay and
        TCGplayer links.
      </p>
      <div class="flex items-center gap-3" aria-label="Affiliate marketplaces">
        <span class="inline-flex items-center rounded-md border border-sand-200 bg-sand-50 px-2.5 py-1.5 shadow-sm">
          <img src={ebayLogoUrl} alt="eBay" width="1000" height="401" class="h-3.5 w-auto" loading="lazy" />
        </span>
        <span class="inline-flex items-center rounded-md border border-sand-200 bg-sand-50 px-2.5 py-1.5 shadow-sm">
          <img src={tcgplayerLogoUrl} alt="TCGplayer" width="801" height="337" class="h-4 w-auto" loading="lazy" />
        </span>
      </div>
    </div>
  </div>
</footer>
