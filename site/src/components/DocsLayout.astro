---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
  title: string;
  description: string;
  /** Path of the current page, e.g. "/docs/swipe", for active-link state. */
  current: string;
}

const { title, description, current } = Astro.props;

// Canonical docs navigation. Grouped so the sidebar reads as an outline.
// Pages are added here as they ship; everything listed has a real page.
const docsNav: { group: string; links: { href: string; label: string }[] }[] = [
  {
    group: "Start here",
    links: [
      { href: "/docs", label: "Overview" },
      { href: "/getting-started", label: "Getting started" },
      { href: "/docs/faq", label: "FAQ" },
    ],
  },
  {
    group: "The three ways in",
    links: [
      { href: "/docs/swipe", label: "Swipe" },
      { href: "/docs/browse", label: "Browse" },
      { href: "/docs/search", label: "Search" },
    ],
  },
];

const linkBase =
  "block rounded-md px-3 py-1.5 text-sm transition";
const linkIdle =
  "text-coconut-500 hover:text-coconut-700 hover:bg-sand-100 dark:text-sand-300 dark:hover:text-sand-50 dark:hover:bg-husk-100";
const linkActive =
  "bg-sand-200 font-semibold text-coconut-700 dark:bg-husk-100 dark:text-sand-50";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
    <div class="grid gap-10 md:grid-cols-[14rem_1fr]">
      {/* Sidebar */}
      <aside class="md:sticky md:top-24 md:self-start">
        <nav aria-label="Docs">
          {
            docsNav.map((section) => (
              <div class="mb-6">
                <p class="px-3 text-xs font-semibold uppercase tracking-wider text-sand-500 dark:text-sand-400">
                  {section.group}
                </p>
                <ul class="mt-2 space-y-0.5">
                  {section.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        aria-current={current === link.href ? "page" : undefined}
                        class={`${linkBase} ${current === link.href ? linkActive : linkIdle}`}
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </aside>

      {/* Content */}
      <article class="min-w-0 max-w-2xl">
        <slot />
      </article>
    </div>
  </main>
  <Footer />
</BaseLayout>
