---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Icon from "./Icon.astro";

interface Props {
  title: string;
  description: string;
  /** Path of the current page, e.g. "/docs/swipe", for active-link state. */
  current: string;
  /** Standard page header. Omit `heading` to render a bare <slot/> page. */
  icon?: string;
  accent?: "sun" | "palm" | "sky" | "ember";
  eyebrow?: string;
  heading?: string;
  lede?: string;
}

const {
  title,
  description,
  current,
  icon,
  accent = "palm",
  eyebrow,
  heading,
  lede,
} = Astro.props;

// Token-only icon-badge accents. sky/ember lack light tints in the palette,
// so those use an opacity wash; sun/palm have full scales.
const accents: Record<string, string> = {
  sun: "bg-sun-100 text-sun-600 dark:bg-sun-400/15 dark:text-sun-300",
  palm: "bg-palm-100 text-palm-600 dark:bg-palm-500/15 dark:text-palm-300",
  sky: "bg-sky-500/12 text-sky-500 dark:bg-sky-400/15 dark:text-sky-300",
  ember: "bg-ember-500/12 text-ember-500 dark:bg-ember-400/15 dark:text-ember-300",
};

// Canonical docs navigation. Grouped so the sidebar reads as an outline.
// Icons mirror the app's own choices where they overlap (Swipe=Layers,
// Browse=GalleryHorizontalEnd, Wishlist=Footprints, Binder=Library, …).
const docsNav: {
  group: string;
  links: { href: string; label: string; icon: string }[];
}[] = [
  {
    group: "Start here",
    links: [
      { href: "/docs", label: "Overview", icon: "compass" },
      { href: "/getting-started", label: "Getting started", icon: "book-open" },
      { href: "/docs/faq", label: "FAQ", icon: "circle-help" },
    ],
  },
  {
    group: "The three ways in",
    links: [
      { href: "/docs/swipe", label: "Swipe", icon: "layers" },
      { href: "/docs/browse", label: "Browse", icon: "gallery-horizontal-end" },
      { href: "/docs/search", label: "Search", icon: "search" },
    ],
  },
  {
    group: "Your stuff",
    links: [
      { href: "/docs/backpack", label: "Backpack", icon: "backpack" },
      { href: "/docs/wishlists", label: "Wishlists", icon: "footprints" },
      { href: "/docs/collections", label: "Collections", icon: "book" },
      { href: "/docs/binders", label: "Binders", icon: "library" },
      { href: "/docs/saved-searches", label: "Saved searches", icon: "bookmark" },
    ],
  },
  {
    group: "Account & output",
    links: [
      { href: "/docs/account", label: "Account & sign-in", icon: "circle-user" },
      { href: "/docs/exports", label: "Exports", icon: "download" },
    ],
  },
];

const linkBase =
  "flex items-center gap-2.5 rounded-md px-3 py-1.5 text-sm transition";
const linkIdle =
  "text-coconut-500 hover:text-coconut-700 hover:bg-sand-100 dark:text-sand-300 dark:hover:text-sand-50 dark:hover:bg-husk-100";
const linkActive =
  "bg-sand-200 font-semibold text-coconut-700 dark:bg-husk-100 dark:text-sand-50";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
    <div class="grid gap-10 md:grid-cols-[14rem_1fr]">
      {/* Sidebar */}
      <aside class="md:sticky md:top-24 md:self-start">
        <nav aria-label="Docs">
          {
            docsNav.map((section) => (
              <div class="mb-6">
                <p class="px-3 text-xs font-semibold uppercase tracking-wider text-sand-500 dark:text-sand-400">
                  {section.group}
                </p>
                <ul class="mt-2 space-y-0.5">
                  {section.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        aria-current={current === link.href ? "page" : undefined}
                        class={`${linkBase} ${current === link.href ? linkActive : linkIdle}`}
                      >
                        <Icon
                          name={link.icon}
                          class={`h-4 w-4 shrink-0 ${current === link.href ? "text-palm-500 dark:text-sun-300" : "text-sand-500 dark:text-sand-400"}`}
                        />
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </aside>

      {/* Content */}
      <article class="min-w-0 max-w-2xl">
        {
          heading && (
            <header class="mb-10">
              <div class="flex items-center gap-3">
                <span
                  class={`inline-flex h-11 w-11 items-center justify-center rounded-xl ${accents[accent]}`}
                >
                  <Icon name={icon ?? "compass"} class="h-5 w-5" />
                </span>
                {eyebrow && (
                  <p class="text-xs font-semibold uppercase tracking-wider text-sand-500 dark:text-sand-400">
                    {eyebrow}
                  </p>
                )}
              </div>
              <h1 class="mt-5 text-3xl sm:text-4xl font-bold tracking-tight text-coconut-700 dark:text-sand-50">
                {heading}
              </h1>
              {lede && (
                <p class="mt-4 text-lg text-coconut-500 dark:text-sand-200">{lede}</p>
              )}
            </header>
          )
        }
        <slot />
      </article>
    </div>
  </main>
  <Footer />
</BaseLayout>
