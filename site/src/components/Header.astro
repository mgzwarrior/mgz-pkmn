---
import ThemeToggle from "./ThemeToggle.astro";
import logoLightUrl from "../../../assets/logo.svg?url";
import logoDarkUrl from "../../../assets/logo-dark.svg?url";

const repoUrl = "https://github.com/mgzwarrior/mgz-pkmn";
const demoUrl = "https://mgz-pkmn.onrender.com";

// Primary nav. Vendors lives in the footer, not here — the homepage's
// vendor-interest callout is the in-page surface for it. Subscribe is a page
// section (EmailSignup), not a nav destination. `accent` marks the links that
// leave the homepage for a separate page (Docs, Contribute) so they read
// subtly distinct from the in-page anchors (Why, Features, How it works).
const navLinks = [
  { href: "/#why", label: "Why", accent: false },
  { href: "/#features", label: "Features", accent: false },
  { href: "/#how-it-works", label: "How it works", accent: false },
  { href: "/docs", label: "Docs", accent: true },
  { href: "/contribute", label: "Contribute", accent: true },
];

const linkClass =
  "px-3 py-2 rounded-md text-coconut-500 hover:text-coconut-700 hover:bg-sand-100 dark:text-sand-200 dark:hover:text-sand-50 dark:hover:bg-husk-100 transition";
const accentLinkClass =
  "px-3 py-2 rounded-md text-palm-500 hover:text-palm-400 hover:bg-sand-100 dark:text-sun-300 dark:hover:text-sun-200 dark:hover:bg-husk-100 transition";
// Octocat mark, reused inline (desktop) and in the mobile drawer.
const octocatPath =
  "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z";
// No display utility here — the use site sets `hidden md:inline-flex` so the
// mark stays desktop-only. Baking in `inline-flex` would defeat `hidden`.
const githubLinkClass =
  "items-center px-3 py-2 rounded-md text-coconut-500 hover:text-coconut-700 hover:bg-sand-100 dark:text-sand-200 dark:hover:text-sand-50 dark:hover:bg-husk-100 transition";
const demoClass =
  "inline-flex items-center rounded-md bg-sun-300 px-4 py-2 text-sm font-semibold text-coconut-700 shadow-sm hover:bg-sun-400 dark:text-husk-500 dark:hover:bg-sun-200 transition";
---

<header
  class="border-b border-sand-300 bg-sand-50/80 dark:border-husk-200/80 dark:bg-husk-400/70 backdrop-blur sticky top-0 z-20"
>
  <nav
    class="mx-auto max-w-6xl px-6 py-4 flex items-center justify-between gap-4"
    aria-label="Primary"
  >
    <a
      href="/"
      class="flex shrink-0 items-center gap-2"
      aria-label="mgz-pkmn home"
    >
      <img
        src={logoLightUrl}
        alt=""
        width="180"
        height="44"
        class="h-8 w-auto dark:hidden"
      />
      <img
        src={logoDarkUrl}
        alt=""
        width="180"
        height="44"
        class="hidden h-8 w-auto dark:block"
      />
    </a>

    {/* Everything right of the logo, right-justified: links then controls */}
    <div class="flex items-center gap-1 md:gap-2">
      <ul class="hidden md:flex items-center gap-1 text-sm">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class={link.accent ? accentLinkClass : linkClass}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      {/* Controls: GitHub · theme · Demo (mobile gets the menu button) */}
      <a href={repoUrl} aria-label="GitHub" class={`hidden md:inline-flex ${githubLinkClass}`}>
        <svg class="h-5 w-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d={octocatPath}></path>
        </svg>
      </a>
      <span class="hidden md:inline-flex">
        <ThemeToggle />
      </span>
      <a href={demoUrl} class={demoClass}>Demo</a>
      <button
        id="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-controls="mobile-drawer"
        aria-expanded="false"
        class="md:hidden inline-flex h-9 w-9 items-center justify-center rounded-md text-coconut-500 hover:text-coconut-700 hover:bg-sand-100 dark:text-sand-200 dark:hover:text-sand-50 dark:hover:bg-husk-100 transition"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

{/* Mobile slide-out drawer */}
<div id="mobile-drawer" class="md:hidden">
  <div
    id="drawer-backdrop"
    class="fixed inset-0 z-30 bg-coconut-700/40 opacity-0 pointer-events-none transition-opacity duration-200 dark:bg-husk-500/60"
  >
  </div>
  <aside
    id="drawer-panel"
    aria-label="Menu"
    inert
    class="fixed inset-y-0 right-0 z-40 flex w-72 max-w-[80vw] translate-x-full flex-col border-l border-sand-300 bg-sand-50 shadow-2xl transition-transform duration-200 ease-out dark:border-husk-200 dark:bg-husk-400"
  >
    <div
      class="flex items-center justify-between border-b border-sand-300 px-4 py-4 dark:border-husk-200/80"
    >
      <span class="text-sm font-semibold text-coconut-500 dark:text-sand-200">Menu</span>
      <button
        id="drawer-close"
        type="button"
        aria-label="Close menu"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md text-coconut-500 hover:text-coconut-700 hover:bg-sand-100 dark:text-sand-200 dark:hover:text-sand-50 dark:hover:bg-husk-100 transition"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <ul class="flex flex-col gap-1 px-3 py-4 text-base">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class={`block ${link.accent ? accentLinkClass : linkClass}`}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    {/* Controls grouped on the left so they clear the Buy-Me-a-Coffee
        floating widget, which the BMC script pins to the bottom-right. */}
    <div
      class="mt-auto flex items-center gap-2 border-t border-sand-300 px-3 py-4 dark:border-husk-200/80"
    >
      <a
        href={repoUrl}
        class="flex items-center gap-2 rounded-md px-2 py-2 text-sm text-coconut-500 hover:text-coconut-700 hover:bg-sand-100 dark:text-sand-200 dark:hover:text-sand-50 dark:hover:bg-husk-100 transition"
      >
        <svg class="h-5 w-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d={octocatPath}></path>
        </svg>
        GitHub
      </a>
      <ThemeToggle />
    </div>
  </aside>
</div>

<script is:inline>
  (function () {
    var btn = document.getElementById("menu-toggle");
    var backdrop = document.getElementById("drawer-backdrop");
    var panel = document.getElementById("drawer-panel");
    var closeBtn = document.getElementById("drawer-close");
    if (!btn || !backdrop || !panel) return;

    function setOpen(open) {
      panel.classList.toggle("translate-x-full", !open);
      backdrop.classList.toggle("opacity-0", !open);
      backdrop.classList.toggle("pointer-events-none", !open);
      btn.setAttribute("aria-expanded", String(open));
      document.documentElement.classList.toggle("overflow-hidden", open);
      // Keep the off-screen panel out of the focus order / a11y tree so
      // keyboard and screen-reader users can't tab into a closed drawer.
      panel.inert = !open;
    }

    btn.addEventListener("click", function () {
      setOpen(panel.classList.contains("translate-x-full"));
    });
    if (closeBtn) {
      closeBtn.addEventListener("click", function () {
        setOpen(false);
      });
    }
    backdrop.addEventListener("click", function () {
      setOpen(false);
    });
    // Close after navigating to an in-page or new-page link.
    panel.querySelectorAll("a").forEach(function (a) {
      a.addEventListener("click", function () {
        setOpen(false);
      });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") setOpen(false);
    });
  })();
</script>
