---
const repoUrl = "https://github.com/mgzwarrior/mgz-pkmn";
---

<header class="border-b border-sand-300 bg-sand-50/80 backdrop-blur sticky top-0 z-10">
  <nav
    class="mx-auto max-w-6xl px-6 py-4 flex items-center justify-between"
    aria-label="Primary"
  >
    <a href="/" class="flex items-center gap-2" aria-label="mgz-pkmn home">
      <img src="/favicon.svg" alt="" width="120" height="30" class="h-7 w-auto" />
    </a>
    <ul class="flex items-center gap-1 sm:gap-2 text-sm">
      <li>
        <a
          href="/#features"
          class="px-3 py-2 rounded-md text-coconut-500 hover:text-coconut-700 hover:bg-sand-100 transition"
          >Features</a
        >
      </li>
      <li class="hidden sm:list-item">
        <a
          href="/#how-it-works"
          class="px-3 py-2 rounded-md text-coconut-500 hover:text-coconut-700 hover:bg-sand-100 transition"
          >How it works</a
        >
      </li>
      <li class="hidden sm:list-item">
        <a
          href="/#roadmap"
          class="px-3 py-2 rounded-md text-coconut-500 hover:text-coconut-700 hover:bg-sand-100 transition"
          >Roadmap</a
        >
      </li>
      <li>
        <a
          href="/contribute"
          class="px-3 py-2 rounded-md text-palm-500 hover:text-palm-400 hover:bg-sand-100 transition"
          >Contribute</a
        >
      </li>
      <li>
        <a
          href={repoUrl}
          class="px-3 py-2 rounded-md text-coconut-500 hover:text-coconut-700 hover:bg-sand-100 transition"
          >GitHub</a
        >
      </li>
    </ul>
  </nav>
</header>
